<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:id="@+id/calib_step"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/calib_title"
        android:textColor="#E3C27A"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/calib_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="8dp"
        android:gravity="center"
        android:text="@string/calib_intro"
        android:textColor="#FFFFFF"
        android:textDirection="rtl"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/calib_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#9A9A9A"
        android:textSize="13sp" />

    <Button
        android:id="@+id/calib_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/pill"
        android:paddingHorizontal="16dp"
        android:text="@string/prayer_start"
        android:textColor="#000000"
        android:textSize="14sp" />
</LinearLayout>
