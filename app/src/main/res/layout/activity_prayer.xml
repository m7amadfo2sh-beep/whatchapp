<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ScrollView
        android:id="@+id/picker"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/picker_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:layoutDirection="rtl"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/prayer_choose"
                android:textColor="#E3C27A"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/recite_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/recite_toggle"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/prayer_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/other_minus"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/toggle_off"
                    android:text="−"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/other_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/other_plus"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/toggle_off"
                    android:text="+"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <Button
                android:id="@+id/other_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/pill"
                android:paddingHorizontal="14dp"
                android:textColor="#000000"
                android:textSize="14sp" />

            <Button
                android:id="@+id/recite_only"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/toggle_off"
                android:paddingHorizontal="12dp"
                android:text="@string/recite_only"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/recalibrate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:padding="6dp"
                android:text="@string/prayer_recalibrate"
                android:textColor="#9AD0FF"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/live"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/live_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E3C27A"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/live_rakah"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="54sp" />

        <TextView
            android:id="@+id/live_posture"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#9A9A9A"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/live_recite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#9AD0FF"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/prayer_hint"
            android:textColor="#777777"
            android:textSize="11sp" />

        <Button
            android:id="@+id/live_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/toggle_off"
            android:paddingHorizontal="16dp"
            android:text="@string/prayer_end"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
